	<!-- Optional small script for interaction -->
	<script>
		// focus search on Ctrl+K
		document.addEventListener('keydown', function(e){
			if((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k'){
				e.preventDefault();
				document.querySelector('.search').focus();
			}
		});
	</script>
